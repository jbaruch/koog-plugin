# Required CI secrets for jbaruch/koog-plugin
#
# Set these as GitHub Actions repository secrets, NOT as local .env values —
# the gh-aw reviewer workflows under .github/workflows/ read them from the
# Actions secrets store, never from a checked-in .env file.
#
# Configure them at:
#   https://github.com/jbaruch/koog-plugin/settings/secrets/actions
#
# Merging a PR before all three are set will cause the first reviewer run to
# fail on the "Validate <secret> secret" activation step.

# OpenAI API key — billing account for the Codex reviewer workflow
# (review-openai.lock.yml). Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key — billing account for the Claude Code reviewer workflow
# (review-anthropic.lock.yml). Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Tessl registry token — used by both reviewer workflows' `tessl install`
# setup step to fetch jbaruch/coding-policy at workflow time.
# Generate at https://tessl.io/account/api-keys
TESSL_TOKEN=tessl_xxxxxxxxxxxxxxxxxxxxxxxx
