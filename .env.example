# GitHub Actions registry credential for jbaruch/koog-plugin.
# Configure at https://github.com/jbaruch/koog-plugin/settings/secrets/actions
# The Publish Plugin workflow uses this token to review and publish the plugin.
# Generate at https://tessl.io/account/api-keys
TESSL_TOKEN=tessl_xxxxxxxxxxxxxxxxxxxxxxxx

# Application keys for the OpenAI and Anthropic scaffolding examples.
# Get an OpenAI API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# Get an Anthropic API key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Required application settings when using add-persistence with PostgreSQL.
# These are application environment variables, not GitHub Actions secrets.
# JDBC connection URL: obtain the host, port and database from the database
# service's connection settings or the database administrator.
CHECKPOINT_JDBC_URL=jdbc:postgresql://localhost:5432/agents
# Database role: obtain a provisioned role from the database administrator/service.
CHECKPOINT_DB_USER=your-db-role
# Role password: obtain from the database administrator or credential store.
CHECKPOINT_DB_PASSWORD=your-db-password
